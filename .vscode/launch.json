{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Main App",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/bot",
            "cwd": "${workspaceFolder}",
            "compilerOptions": {
                "flags": ["-N", "-l"]
            }
        },
        {
            "name": "Debug Test (Current File)",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}"
        },
        {
            "name": "Debug MythicRuns Test",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/internal/worker",
            "args": [
                "-test.run",
                "TestMythicStep"
            ]
        }
    ]
}